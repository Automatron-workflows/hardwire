{
  "name": "hardwire",
  "version": "0.4.1",
  "description": "Typed action panels, static inference, MCP tool descriptions and verifiable trace digests. Experimental; no executor.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://github.com/Automatron-workflows/hardwire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automatron-workflows/hardwire.git"
  },
  "bugs": {
    "url": "https://github.com/Automatron-workflows/hardwire/issues"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "bin": {
    "hardwire": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./panel": "./src/panel.mjs",
    "./probe": "./src/probe.mjs",
    "./mcp": "./src/mcp.mjs",
    "./trace": "./src/trace.mjs",
    "./infer": "./src/infer.mjs",
    "./score": "./src/score.mjs",
    "./corpus": "./src/corpus.mjs"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "validate": "node src/cli.mjs validate examples/example-panel.json",
    "audit": "node src/cli.mjs audit examples/example-panel.json",
    "compile": "node src/cli.mjs compile examples/example-panel.json",
    "score": "node src/cli.mjs score --expected examples/corpus/shop/expected.json --infer examples/corpus/shop/page.html",
    "corpus": "node src/cli.mjs corpus examples/corpus",
    "demo": "node examples/demo/server.mjs",
    "walkthrough": "node examples/walkthrough.mjs",
    "consumer": "node examples/consumer.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "check": "npm test && npm run validate && npm run walkthrough && npm run consumer && npm run test:package"
  },
  "keywords": [
    "agents",
    "mcp",
    "webmcp",
    "browser-automation",
    "accessibility",
    "tool-calling"
  ]
}
