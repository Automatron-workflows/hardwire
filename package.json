{
  "name": "hardwire",
  "version": "0.7.1",
  "description": "Describe and validate application actions for AI agents. Open source tools for reviewing inputs, declared effects and approval requirements.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Automatron-workflows/hardwire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automatron-workflows/hardwire.git"
  },
  "bugs": {
    "url": "https://github.com/Automatron-workflows/hardwire/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "hardwire": "./src/cli.mjs",
    "hardwire-mcp": "./src/mcp-server.mjs",
    "hardwire-experiment": "./examples/experiment.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./panel": "./src/panel.mjs",
    "./probe": "./src/probe.mjs",
    "./mcp": "./src/mcp.mjs",
    "./trace": "./src/trace.mjs",
    "./infer": "./src/infer.mjs",
    "./score": "./src/score.mjs",
    "./corpus": "./src/corpus.mjs",
    "./canonical": "./src/canonical.mjs",
    "./browser": "./src/browser.mjs"
  },
  "files": [
    "src",
    "scripts/client-config.mjs",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "playground",
    "scripts/build-playground.mjs",
    "CODE_OF_CONDUCT.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "validate": "node src/cli.mjs validate examples/example-panel.json",
    "audit": "node src/cli.mjs audit examples/example-panel.json",
    "compile": "node src/cli.mjs compile examples/example-panel.json",
    "score": "node src/cli.mjs score --expected examples/corpus/shop/expected.json --infer examples/corpus/shop/page.html",
    "corpus": "node src/cli.mjs corpus examples/corpus",
    "demo": "node examples/demo/server.mjs",
    "walkthrough": "node examples/walkthrough.mjs",
    "consumer": "node examples/consumer.mjs",
    "experiment": "node examples/experiment.mjs",
    "mcp": "node src/mcp-server.mjs",
    "mcp:config": "node scripts/client-config.mjs",
    "test:mcp": "node scripts/check-mcp.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "check": "npm test && npm run validate && npm run experiment && npm run walkthrough && npm run consumer && npm run test:mcp && npm run test:package && npm run build:playground",
    "build:playground": "node scripts/build-playground.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "keywords": [
    "agents",
    "mcp",
    "webmcp",
    "browser-automation",
    "accessibility",
    "tool-calling"
  ]
}
